<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <permission android:name="live.tianyi.tvadbkeeper.permission.HOME_READY"
        android:protectionLevel="signature" />
    <!-- Development permission: explicitly granted by an already-authorized ADB shell. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <application android:label="家庭电视 ADB 维护" android:allowBackup="false" android:directBootAware="true">
        <receiver android:name=".HomeReadyReceiver" android:exported="true" android:directBootAware="true"
            android:permission="live.tianyi.tvadbkeeper.permission.HOME_READY" />
        <activity android:name=".SetupActivity" android:exported="true"
            android:permission="android.permission.DUMP" android:theme="@android:style/Theme.NoDisplay" />
        <receiver android:name=".RestoreReceiver" android:exported="true" android:directBootAware="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="mitv.action.STR_BOOT_COMPLETED" />
                <action android:name="live.tianyi.tvadbkeeper.RESTORE" />
            </intent-filter>
        </receiver>
        <service android:name=".RestoreJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
    </application>
</manifest>
